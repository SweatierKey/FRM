[7.65,"o","\u001b[1;35m$\u001b[0m frm plan restart 'ohs_*'\r\n"]
[8.1,"o","INSTANCE                 BACKEND    COMMAND\r\n------------------------ ---------- ----------------------------------------\r\nohs_api                  systemd    /usr/bin/systemctl stop ohs_api\r\n                         systemd    /usr/bin/systemctl start ohs_api\r\nohs_legacy_11119         opmn       /u01/app/oracle/admin/ohs_legacy_11119/bin/opmnctl stopall\r\n                         opmn       /u01/app/oracle/admin/ohs_legacy_11119/bin/opmnctl startall\r\nohs_portal               systemd    /usr/bin/systemctl stop ohs_portal\r\n                         systemd    /usr/bin/systemctl start ohs_portal\r\n"]
[9.75,"o","\u001b[1;35m$\u001b[0m frm --dry-run restart ohs_portal\r\n"]
[10.2,"o","\u001b[36mDRY-RUN restart instance: ohs_portal\u001b[0m\r\n\u001b[36mDRY-RUN  ohs_portal  systemd  /usr/bin/systemctl stop ohs_portal\u001b[0m\r\n\u001b[36mDRY-RUN  ohs_portal  systemd  /usr/bin/systemctl start ohs_portal\u001b[0m\r\n"]
