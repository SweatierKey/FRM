#####################################
 # Defaults / environment
diff --git a/lib/10-status.sh b/lib/10-status.sh
index 2532955..ef84260 100644
--- a/lib/10-status.sh
+++ b/lib/10-status.sh
@@ -5,7 +5,9 @@ instance_httpd_info() {
     local instance="$1"
     local instance_path="$FRM_INSTANCES_DIR/$instance/"
 
-    ps -eo pid=,ppid=,comm=,args= 2>/dev/null |
+    # RHEL7/procps may truncate args to the display width when stdout is a pipe.
+    # The OHS instance path can appear after column 80, so force unlimited width.
+    ps -ww -eo pid=,ppid=,comm=,args= 2>/dev/null |
         awk -v instance_path="$instance_path" '
             {
                 pid=$1
diff --git a/lib/30-inspection.sh b/lib/30-inspection.sh
index 0b42c95..32ba644 100644
--- a/lib/30-inspection.sh
+++ b/lib/30-inspection.sh
@@ -26,7 +26,7 @@ processes_instances() {
         printf '\n'
         printf '  %-10s %-8s %-8s %-12s %s\n' "USER" "PID" "PPID" "ELAPSED" "COMMAND"
 
-        ps -eo user=,pid=,ppid=,etime=,args= 2>/dev/null |
+        ps -ww -eo user=,pid=,ppid=,etime=,args= 2>/dev/null |
             awk -v master="$master" -v instance_path="$path" '
                 {
                     user=$1
diff --git a/lib/40-help-core.sh b/lib/40-help-core.sh
index 7bf485c..0ab1e29 100644
--- a/lib/40-help-core.sh
+++ b/lib/40-help-core.sh
@@ -67,7 +67,7 @@ COMMANDS
   list [--long] [--json] [selectors...]
       List detected OHS instances. --long adds family/backend/path.
 
-  status [--json|--tsv] [--summary] [--verbose] [selectors...]
+  status [--json|--tsv] [--summary] [--verbose] [--debug] [selectors...]
       Show current runtime state. Table output is compact by default.
       --verbose emits native backend output before the derived state.
 
@@ -188,6 +188,7 @@ Structured formats:
 Verbose native output:
   frm status --verbose ohs_jrv
   frm --debug status       # native output + discovery/debug diagnostics
+  frm status --debug       # equivalent command-local form
 
 Summary:
   frm status --summary
diff --git a/lib/50-cli.sh b/lib/50-cli.sh
index 69ff7bd..a702714 100644
--- a/lib/50-cli.sh
+++ b/lib/50-cli.sh
@@ -177,6 +177,10 @@ parse_status_args() {
             --tsv) FRM_STATUS_FORMAT=tsv ;;
             --summary) FRM_STATUS_SUMMARY=true ;;
             --verbose|-v) FRM_VERBOSE_STATUS=true ;;
+            --debug|-d)
+                FRM_DEBUG=true
+               